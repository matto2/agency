---
const { title, fullBleed = false } = Astro.props;
const fullTitle = title.includes("O’Leary") ? title : `${title} — Matthew O’Leary`;
import "../styles/main.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "@fontsource-variable/hanken-grotesk";
import "@fontsource/lora/400-italic.css";
import { ClientRouter } from "astro:transitions";
import { SEO } from "astro-seo";
---

<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-R5KX3494C0"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-R5KX3494C0');
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <SEO
      title={fullTitle}
      description="Print production lead with 20+ years in magazine publishing, CPG packaging and enterprise marketing. I run production end to end, from file standards and preflight to printer relationships and press, and build the files myself."
      openGraph={{
        basic: {
          title: "Matthew O’Leary — Print Production Lead",
          type: "website",
          image: "https://mattoleary.design/images/og-image.jpg",
        },
      }}
      extend={{
        link: [{ rel: "icon", href: "/favicon.ico" }],
        meta: [
          {
            name: "description",
            content:
              "Print production lead with 20+ years in magazine publishing, CPG packaging and enterprise marketing. I run production end to end, from file standards and preflight to printer relationships and press, and build the files myself.",
          },
          {
            name: "og:image",
            content: "https://mattoleary.design/images/og-image.jpg",
          },
          {
            name: "og:title",
            content: "Matthew O’Leary — Print Production Lead",
          },
          {
            name: "og:description",
            content:
              "Print production lead with 20+ years in magazine publishing, CPG packaging and enterprise marketing. I run production end to end, from file standards and preflight to printer relationships and press, and build the files myself.",
          },
        ],
      }}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <ClientRouter />
  </head>
  <body>
    <div class="flex flex-col min-h-screen justify-between w-full">
      <header class="w-full"><Nav /></header>

      <main
        class="mb-auto w-full flex justify-center"
        transition:animate="fade"
      >
        {fullBleed ? (
          <div class="w-full"><slot /></div>
        ) : (
          <div class="w-full max-w-7xl px-2 md:px-4">
            <slot />
          </div>
        )}
      </main>
      <Footer />
    </div>
  <script>
  // Reloading the page should start at the top, not wherever the browser last had you scrolled to
  if (performance.getEntriesByType('navigation')[0]?.type === 'reload') {
    history.scrollRestoration = 'manual';
    window.scrollTo(0, 0);
  }

  // Scroll-triggered animations
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, observerOptions);

  // Observe all elements with animate-on-scroll class
  document.querySelectorAll('.animate-on-scroll').forEach(el => {
    observer.observe(el);
  });

  // Re-run on page transitions
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.animate-on-scroll').forEach(el => {
      observer.observe(el);
    });
  });

  // Style apostrophe in "I'm" with adjusted spacing
  function styleApostrophes() {
    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
    const textNodes = [];
    while (walker.nextNode()) textNodes.push(walker.currentNode);

    textNodes.forEach(node => {
      if (node.nodeValue && /I\u2019m/.test(node.nodeValue) && node.parentElement?.tagName !== 'SCRIPT' && node.parentElement?.tagName !== 'STYLE') {
        const span = document.createElement('span');
        span.innerHTML = node.nodeValue.replace(/I\u2019m/g, 'I<span class="apos">\u2019</span>m');
        node.parentNode?.replaceChild(span, node);
      }
    });
  }

  styleApostrophes();
  document.addEventListener('astro:page-load', styleApostrophes);
</script>
</body>
</html>
