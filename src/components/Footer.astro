---
import Logo from "./Logo.astro";

const isWebsitesPage = Astro.url.pathname.startsWith("/websites");
// The hero photo credit only belongs on the home page, where the photo appears
const isHomePage = Astro.url.pathname === "/";
---

<footer class="bg-bg px-4 pt-14 pb-10 text-center">
  <div class="max-w-container mx-auto flex flex-col items-center gap-6">
    <Logo size="sm" />

    <ul class="list-none m-0 p-0 flex flex-wrap justify-center caps text-ink">
      <li><a href="/" class="footer-link">Home</a></li>
      <li><a href="/contact" class="footer-link">Contact</a></li>
      {!isWebsitesPage && (
        <li><a href="/websites" class="footer-link">Need a new website?</a></li>
      )}
      <li><a href="mailto:matt@mattoleary.design" class="footer-link">matt@mattoleary.design</a></li>
      <li><a href="tel:8312752566" class="footer-link">(831) 275-2566</a></li>
      <li><a href="https://www.linkedin.com/in/matt-oleary/" class="footer-link">/in/matt-oleary</a></li>
    </ul>

    <p class="photo-credit text-label text-muted m-0">
      {isHomePage && (
        <>
          Hero photo by <a href="https://unsplash.com/@maxberg?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText">Maxim Berg</a> on <a href="https://unsplash.com/photos/a-multicolored-background-with-lines-of-different-colors-qsDfqZyTCAE?utm_source=unsplash&utm_medium=referral&utm_content=creditCopyText">Unsplash</a>
          <span class="mx-2" aria-hidden="true">&middot;</span>
        </>
      )}
      &copy; <span class="copyright-year"></span> Matthew O&rsquo;Leary
    </p>
  </div>
</footer>

<script>
  const setYear = () =>
    document.querySelectorAll(".copyright-year").forEach((el) => {
      el.textContent = new Date().getFullYear().toString();
    });
  setYear();
  document.addEventListener("astro:page-load", setYear);
</script>

<style>
  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.75rem;
    transition: color 0.2s ease;
  }
  .footer-link:hover {
    color: var(--color-link-hover);
  }
  .photo-credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .photo-credit a:hover {
    color: var(--color-link-hover);
  }
</style>
