---
const { img, alt, title, link } = Astro.props;
import { Image } from "astro:assets";
---

<div class="my-8 w-full animate-on-scroll">
  <div
    class="max-w-xl rounded-token overflow-hidden bg-bg border border-rule transition-all duration-300"
  >
    <!-- Outer container to control overflow and clipping -->
    <div class="overflow-hidden relative group">
      <a href={link} class="block">
        <div class="aspect-[4/3] overflow-hidden">
          <Image src={img} class="w-full h-full object-cover" alt={alt} />
        </div>
      </a>
    </div>
    <div class="px-4 py-3">
      <a href={link} class="block">
        <div class="font-medium text-neutral-700 group-hover:text-band transition-colors">{title}</div>
      </a>
    </div>
  </div>
</div>
