---
// Stacked wordmark. size="sm" is the footer version.
const { size = "lg" } = Astro.props;
---

<a href="/" class="inline-block py-1 text-ink hover:text-ink">
  <p
    class:list={[
      "font-bold uppercase text-center leading-[0.95] tracking-[0.04em] m-0",
      size === "sm" ? "text-wordmark-sm" : "text-wordmark",
    ]}
  >
    <span class="block">Matthew</span>
    <span class="block">O’Leary</span>
  </p>
</a>
