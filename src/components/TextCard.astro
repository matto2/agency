---
const { company, role, description, link } = Astro.props;
---

<div class="my-8 w-full animate-on-scroll">
  <div
    class="max-xl rounded-xl overflow-hidden bg-white/70 backdrop-blur-sm border border-white/50 shadow-md transition-all duration-300 hover:scale-[1.03]"
  >
    <a href={link} class="block">
      <div class="aspect-[4/3] bg-band flex flex-col items-start justify-start p-6">
        <div class="text-highlight text-label font-semibold tracking-section uppercase mb-1">{role}</div>
        <div class="text-white font-medium text-card-title leading-tight mb-2">{company}</div>
        <div class="text-on-band text-label-lg leading-snug">{description}</div>
      </div>
    </a>
    <div class="px-4 py-3">
      <a href={link} class="block">
        <div class="font-medium text-neutral-700 hover:text-band transition-colors">{company}</div>
      </a>
    </div>
  </div>
</div>
