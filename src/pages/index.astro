---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

// Project images
import books from "../assets/books.png";
import juice from "../assets/juice.png";
import martinellisThumb from "../assets/martinellis-fruitvirtues_377.jpg";
import packagingThumb from "../assets/SunQueen-Glamor2.jpg";
import westmarineThumb from "../assets/WestMarine.jpg";
import higherEdThumb from "../assets/Berkeley_glade_afternoon.jpg";
import heroImage from "../assets/cmyk.jpg";
import jackWebsite from "../assets/jack-website.webp";

// Profile photo
import newProfilePic from "../assets/My-biopic_new-profile-pic.jpg";

// Testimonial photos
import abishek from "../assets/abishek.png";
import diana from "../assets/diana.jpg";
import bruce from "../assets/bruce.jpg";
import jennine from "../assets/jennine.jpg";

const capabilities = [
  {
    title: "Production Management & Systems",
    text: "End-to-end ownership of publications and print programs: schedules and page flow in Trello and Asana, file intake, and printer coordination. Templates and InDesign automation\u2014ExtendScript, GREP, Data Merge, and AI to speed up production.",
  },
  {
    title: "Editorial & Publication Production",
    text: "Magazine and publication layouts, complex page composition, typography, parent-page systems, page mapping, image placement, proof corrections, and press-ready editorial files for alumni magazines, books, annual reports, and special editions.",
  },
  {
    title: "Packaging, Labels & Collateral",
    text: "Packaging mechanicals, rigid and flexible dielines, product labels, kitting and retail collateral, POS displays, signage and trade-show graphics, color separations, regulated copy placement, and multi-SKU rollouts.",
  },
  {
    title: "Print Production & Prepress",
    text: "InDesign and Illustrator production files, PDF/X preflight, file proofing, CMYK and spot-color management, naming and delivery standards, press checks, and quality control across offset, digital, and large-format printing.",
  },
];

const featuredWork = [
  { img: higherEdThumb, alt: "Higher-Education Publications", title: "Higher-Education Publications", link: "/work/california-magazine", position: "center top", desc: "Publication layout and production for higher-education magazines, including California magazine." },
  { img: packagingThumb, alt: "Packaging Production — SunQueen", title: "Packaging Production", link: "/work/sunqueen", desc: "Print-ready cartons and a bottle label for a mineral sunscreen product line." },
];

const moreWork = [
  { img: juice, alt: "The Juice Magazine", title: "The Juice Magazine", link: "/work/juice", desc: "Editorial design and production for a quarterly surf magazine I co-founded." },
  { img: westmarineThumb, alt: "West Marine", title: "West Marine", link: "/work/westmarine", desc: "In-house prepress and press checks for monthly mailers and a 600+ page catalog." },
  { img: books, alt: "Book Design & Production", title: "Book Design & Production", link: "/work/books", desc: "Covers, interior typesetting, and print-on-demand files for self-published authors." },
  { img: martinellisThumb, alt: "Production Design", title: "Production Design", link: "/work/production-design", desc: "Packaging and label mechanicals rolled out across flavors, sizes, and variants." },
  // TODO: re-add "Websites for Small Businesses" (jackWebsite, links to /websites) when ready
];

const testimonials = [
  {
    quote: "I worked with Matt on a variety of packaging and communication material design and production projects. Matt is very knowledgeable as well as personable, guiding the process to ensure expected creative outcomes.",
    img: diana,
    alt: "Diana McClean",
    person: "Diana (DeVincenzi) McClean",
    title: "Director of Marketing and Communications",
    company: "Mission Produce",
  },
  {
    quote: "I find it refreshing to work with someone who knows how to tackle big projects while staying calm, focused and creative all while delivering outstanding work.",
    img: jennine,
    alt: "Jennine Dureau",
    person: "Jennine Dureau",
    title: "Marketing Manager",
    company: "TurboTax",
  },
  {
    quote: "Matt is a very creative individual. His knowledge of design as well as production techniques and crafts is invaluable and enables him to participate from start to finish on every project. From book covers to website and page design, Matt\u2019s creative sense is remarkable and invaluable.",
    img: bruce,
    alt: "Bruce Butterfield",
    person: "Bruce Butterfield",
    title: "CEO and Founder",
    company: "The Wittfield Group",
  },
  {
    quote: "Matt is an incredible designer who works hard to identify/solve for customers\u2019 pain points. His designs for critical and heavily used functionality were well received and had a lasting impact on the product adoption.",
    img: abishek,
    alt: "Abishek Aurora",
    person: "Abishek Aurora",
    title: "Director of Product",
    company: "Credit Karma",
  },
];

// Same brands, same order as the former logo grid
const brands = [
  "Axway", "Kiteworks", "West Marine", "Costco", "Wiser", "FastPencil",
  "Cisco", "Martinelli\u2019s", "Cal Alumni Association", "Cal Giant",
  "Tanimura & Antle", "O\u2019Neill", "Big Surf", "Stagnaro", "Annie Glass",
  "Syncplicity",
];
---

<Base title="Matthew O’Leary — Production Designer | Packaging, Editorial & Print" fullBleed>
  <!-- HERO: photo + title band fill the first screen -->
  <div class="hero-fold">
  <div class="hero-photo mx-2">
    <Image
      src={heroImage}
      alt="Abstract streaks of cyan, magenta, and yellow ink"
      widths={[800, 1400, 2000, 2800]}
      sizes="100vw"
      loading="eager"
      class="lead-photo block w-full h-full object-cover"
    />
  </div>

  <!-- TITLE BAND -->
  <section class="on-dark bg-band text-on-band mx-2">
    <div
      class="max-w-container mx-auto px-gutter py-6 md:py-10 grid grid-cols-1 lg:grid-cols-2 lg:items-center gap-4 lg:gap-12"
    >
      <h1 class="m-0 font-medium leading-tight text-on-band">
        <span class="block text-hero">Production Designer</span>
        <span class="block text-intro mt-2">Packaging, Editorial &amp; Print</span>
      </h1>
      <div>
        <p class="m-0 text-body leading-snug">
          I turn approved creative into accurate, organized, press-ready files.
        </p>
        <p class="mt-2 mb-0 text-body font-semibold leading-snug">
          Available for contract and full-time production design roles.
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href="#work" class="btn-highlight">View selected work</a>
          <a href="mailto:matt@mattoleary.design" class="btn-outline-light">Email Matt</a>
        </div>
      </div>
    </div>
  </section>
  </div>

  <!-- SKILLS SECTION -->
  <section class="on-dark bg-band text-on-band px-4 py-section">
    <div class="max-w-container mx-auto px-0 md:px-gutter">
      <div class="section-head animate-on-scroll">
        <h2>Core Capabilities</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16">
        {capabilities.map((item) => (
          <div class="spec-item py-8 animate-on-scroll">
            <h3 class="m-0 mb-3 text-label-lg font-semibold uppercase tracking-caps text-on-band leading-normal">
              <span class="text-highlight mr-2" aria-hidden="true">&raquo;</span>{item.title}
            </h3>
            <p class="m-0 text-body leading-body text-on-band">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WORK GRID SECTION -->
  <section id="work" class="px-4 py-section scroll-mt-4">
    <div class="max-w-wide mx-auto md:px-gutter">
      <div class="section-head mb-5 animate-on-scroll">
        <h2>Selected Work</h2>
      </div>

      <p
        class="text-muted text-body text-center max-w-2xl mx-auto mb-14 animate-on-scroll"
      >
        Selected production work across packaging, editorial, books,
        publications, and print. Select materials have been abbreviated or
        redacted to respect client confidentiality.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-12 mb-12">
        {featuredWork.map((w) => (
          <a href={w.link} class="work-tile group block animate-on-scroll">
            <Image
              src={w.img}
              alt={w.alt}
              widths={[600, 900, 1300]}
              sizes="(min-width: 640px) 50vw, 100vw"
              class="block w-full aspect-[4/3] object-cover"
              style={w.position ? `object-position: ${w.position}` : undefined}
            />
            <span class="block mt-4 text-center text-card-title font-medium text-ink group-hover:text-link-hover transition-colors">
              {w.title}
            </span>
            <span class="block mt-1 mx-auto max-w-[34ch] text-center text-body leading-snug text-muted">
              {w.desc}
            </span>
          </a>
        ))}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
        {moreWork.map((w, i) => (
          <a
            href={w.link}
            class:list={[
              "work-tile group block animate-on-scroll",
              // a lone tile on the last 3-across row sits in the middle column
              i === moreWork.length - 1 && moreWork.length % 3 === 1 && "lg:col-start-2",
            ]}
          >
            <Image
              src={w.img}
              alt={w.alt}
              widths={[500, 800]}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              class="block w-full aspect-[4/3] object-cover"
            />
            <span class="block mt-4 text-center text-card-title font-medium text-ink group-hover:text-link-hover transition-colors">
              {w.title}
            </span>
            <span class="block mt-1 mx-auto max-w-[34ch] text-center text-body leading-snug text-muted">
              {w.desc}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- BIO SECTION -->
  <section id="about" class="px-4 pb-section scroll-mt-4">
    <div class="max-w-[900px] mx-auto">
      <div class="section-head animate-on-scroll">
        <h2>Background &amp; Experience</h2>
      </div>

      <div class="flex flex-col sm:flex-row gap-8 items-center sm:items-start animate-on-scroll">
        <Image
          src={newProfilePic}
          alt="Matthew O’Leary"
          width={370}
          class="shrink-0 w-[150px] h-[185px] object-cover"
        />
        <div class="text-body leading-body text-ink">
          <p class="mt-0 mb-6">
            I&rsquo;m a production designer with 20+ years of experience
            preparing packaging, editorial, book, catalog, and collateral work
            for print. I translate approved creative direction into accurate,
            press-ready files&mdash;handling layouts, mechanicals, dielines,
            revisions, preflight, proofing, color, and vendor handoff.
          </p>
          <p class="mt-0 mb-6">
            Most recently I served as Designer &amp; Production Manager for
            <em>California</em> magazine (Cal Alumni Association), running the
            issue from layout and ad preflight through the printer relationship
            with Quad and post-press file delivery.
          </p>
          <p class="m-0">
            I&rsquo;ve run press checks, managed printer and packaging-vendor
            relationships, coordinated designers, editors, and freelancers
            against hard deadlines using agile workflows, and built the
            templates and standards that keep multi-person production
            consistent. I&rsquo;m especially interested in helping teams
            standardize production workflows, including InDesign scripting
            and AI-assisted tools (Adobe Firefly, Generative Fill), without
            taking creative freedom away from the artists.
          </p>
        </div>
      </div>

      <p
        class="mt-14 mb-0 py-10 border-y border-rule font-quote italic text-quote leading-snug text-center text-ink animate-on-scroll"
      >
        I stay hands-on. I&rsquo;m the person who can own the schedule and
        the vendor call, and also open the file and fix it. That
        combination is what I bring to every project.
      </p>
    </div>
  </section>

  <!-- TESTIMONIALS SECTION -->
  <section class="px-4 pb-section">
    <div class="max-w-container mx-auto md:px-gutter">
      <div class="section-head animate-on-scroll">
        <h2>What People Say</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-x-10 gap-y-14">
        {testimonials.map((t) => (
          <figure class="m-0 grid grid-rows-subgrid row-span-2 gap-0 animate-on-scroll">
            <div class="flex items-start gap-4">
              <Image
                src={t.img}
                alt={t.alt}
                width={144}
                quality={100}
                class="shrink-0 w-[72px] h-[72px] object-cover"
              />
              <div>
                <p class="m-0 text-body font-medium text-ink leading-snug">{t.person}</p>
                <p class="mt-1 mb-0 text-label tracking-[0.5px] text-muted leading-snug">
                  {t.title}
                </p>
              </div>
            </div>
            <blockquote class="mt-5 mx-0 mb-0 text-body leading-body text-ink">
              <p class="m-0">{t.quote}</p>
            </blockquote>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- BRANDS SECTION -->
  <section class="px-4 pb-section">
    <div class="max-w-container mx-auto md:px-gutter">
      <div class="section-head mb-5 animate-on-scroll">
        <h2>Brands I&rsquo;ve Worked With</h2>
      </div>
      <ul
        class="list-none m-0 p-0 flex flex-wrap justify-center gap-y-1 caps text-ink leading-relaxed animate-on-scroll"
      >
        {brands.map((brand, i) => (
          <li class="whitespace-nowrap">
            {i > 0 && <span class="text-band mx-3" aria-hidden="true">&raquo;</span>}{brand}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CONTACT SECTION -->
  <section class="on-dark bg-band-dark text-on-band px-4 py-section">
    <div
      class="max-w-container mx-auto md:px-gutter grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-12 lg:gap-20 items-center"
    >
      <div class="animate-on-scroll">
        <p class="m-0 mb-4 text-label-lg font-semibold uppercase tracking-section">
          Get in Touch
        </p>
        <h2 class="m-0 mb-6 text-h2-band font-medium leading-tight text-on-band">
          Need a detail-oriented production designer?
        </h2>
        <p class="m-0 text-body leading-body">
          I&rsquo;m available for contract and full-time production design
          roles in packaging, editorial, books, and print. Based in Santa Cruz
          and working remotely, with Bay Area onsite availability as needed.
        </p>
      </div>
      <div class="flex flex-col gap-3 w-full lg:w-72 animate-on-scroll">
        <a href="mailto:matt@mattoleary.design" class="btn-highlight w-full">Email Matt</a>
        <a
          href="/OLeary-Resume_Production_Oct2026.pdf"
          target="_blank"
          class="btn-outline-light w-full gap-2"
        >
          <Icon name="pdf" class="w-4 h-4" />
          View résumé
        </a>
        <a
          href="https://www.linkedin.com/in/matt-oleary/"
          target="_blank"
          class="btn-outline-light w-full gap-2"
        >
          <Icon name="linkedin" class="w-4 h-4" />
          LinkedIn
        </a>
        <ul class="list-none m-0 mt-3 p-0 text-body">
          <li><a href="mailto:matt@mattoleary.design" class="contact-link">matt@mattoleary.design</a></li>
          <li><a href="tel:8312752566" class="contact-link">(831) 275-2566</a></li>
          <li><a href="https://www.linkedin.com/in/matt-oleary/" class="contact-link">/in/matt-oleary</a></li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  /* The photo and title band share the first screen: the band takes the height it
     needs and the photo fills what's left below the header (~9.75rem phone, ~13rem desktop). */
  .hero-fold {
    display: flex;
    flex-direction: column;
    height: calc(100svh - 9.75rem);
  }
  .hero-photo {
    position: relative;
    flex: 1 1 auto;
    min-height: 140px;
  }
  .lead-photo {
    position: absolute;
    inset: 0;
    object-position: center;
  }

  @media (min-width: 768px) {
    .hero-fold {
      height: calc(100svh - 13rem);
    }
    .hero-photo {
      min-height: 200px;
    }
  }

  .spec-item {
    border-top: 1px solid color-mix(in srgb, var(--color-on-band) 35%, transparent);
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-underline-offset: 4px;
  }
  .contact-link:hover {
    color: var(--color-highlight);
    text-decoration: underline;
  }
</style>
