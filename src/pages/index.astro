---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import LogoCard from "../components/LogoCard.astro";
import { Image } from "astro:assets";
import Testimonial from "../components/Testimonial.astro";
import LogoField from "../components/LogoField.astro";
import { Icon } from "astro-icon/components";

// Project images
import fastpencilcard from "../assets/fastpencilcard.png";
import axwayLogo from "../assets/axway.svg";
import mcdillLogo from "../assets/mcdill-logo.png";
import books from "../assets/books.png";
import kiteworkscard from "../assets/kiteworkscard.png";
import openbankingcard from "../assets/openbankingcard.png";
import lpc from "../assets/lpc.png";
import juice from "../assets/juice.png";
import martinellisThumb from "../assets/martinellis-fruitvirtues_377.jpg";
import packagingThumb from "../assets/SunQueen-Glamor2.jpg";
import westmarineThumb from "../assets/WestMarine.jpg";
import caMagazineThumb from "../assets/california-magazine-placeholder.svg";
import jackWebsite from "../assets/jack-website.webp";
import jackThumb from "../assets/09_people.BUrkml1d.webp";

// Profile photo
import newProfilePic from "../assets/My-biopic_new-profile-pic.jpg";

// Testimonial photos
import abishek from "../assets/abishek.png";
import diana from "../assets/diana.jpg";
import bruce from "../assets/bruce.jpg";
import jennine from "../assets/jennine.jpg";
---

<Base title="Matthew O’Leary — Graphic Designer & Production Manager">
  <!-- HERO SECTION -->
  <section class="px-4 2xl:px-0 pt-16 pb-6 md:pt-24 md:pb-8">
    <div
      class="flex flex-col md:flex-row items-center gap-8 md:gap-12 max-w-5xl mx-auto"
    >
      <div class="w-48 md:w-64 flex-shrink-0 animate-on-scroll">
        <Image
          src={newProfilePic}
          alt="Matthew O’Leary"
          class="rounded-full ring-4 ring-white shadow-xl"
        />
      </div>
      <div class="text-center md:text-left animate-on-scroll">
        <h1
          class="font-heading text-4xl md:text-5xl xl:text-6xl font-bold mb-6 gradient-text"
        >
          Production Designer
        </h1>
        <p class="text-xl md:text-2xl text-stone-600 leading-relaxed">
          Editorial, print, packaging and marketing design — from concept through press-ready production.
        </p>
      </div>
    </div>
  </section>

  <!-- SKILLS SECTION -->
  <section class="px-4 2xl:px-0 pt-4 pb-16 md:pt-6 md:pb-20 bg-stone-100/50">
    <div class="max-w-6xl mx-auto">
      <p
        class="text-sm font-semibold tracking-widest uppercase text-violet-800 mb-4 text-center animate-on-scroll"
      >
        Areas of Expertise
      </p>
      <h2
        class="font-heading text-3xl md:text-4xl font-bold text-center mb-12 animate-on-scroll"
      >
        Core Capabilities
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        <div
          class="bg-white/80 backdrop-blur-sm border border-white/50 rounded-xl p-6 shadow-md hover:shadow-lg transition-shadow animate-on-scroll"
        >
          <div
            class="w-12 h-12 bg-violet-100 rounded-lg flex items-center justify-center mb-4"
          >
            <svg
              class="w-6 h-6 text-violet-800"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
              ></path>
            </svg>
          </div>
          <h3 class="font-heading font-semibold text-xl mb-2">
            Editorial & Publication Design
          </h3>
          <p class="text-stone-600">
            Magazine layouts, books, covers, typography, page systems and image placement.
          </p>
        </div>

        <div
          class="bg-white/80 backdrop-blur-sm border border-white/50 rounded-xl p-6 shadow-md hover:shadow-lg transition-shadow animate-on-scroll"
        >
          <div
            class="w-12 h-12 bg-violet-100 rounded-lg flex items-center justify-center mb-4"
          >
            <svg
              class="w-6 h-6 text-violet-800"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
          </div>
          <h3 class="font-heading font-semibold text-xl mb-2">
            Print Production & Prepress
          </h3>
          <p class="text-stone-600">
            Press-ready files, preflight (PDF/X), proofing, color management, paper specification, vendor coordination and quality control.
          </p>
        </div>

        <div
          class="bg-white/80 backdrop-blur-sm border border-white/50 rounded-xl p-6 shadow-md hover:shadow-lg transition-shadow animate-on-scroll"
        >
          <div
            class="w-12 h-12 bg-violet-100 rounded-lg flex items-center justify-center mb-4"
          >
            <svg
              class="w-6 h-6 text-violet-800"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
              ></path>
            </svg>
          </div>
          <h3 class="font-heading font-semibold text-xl mb-2">Packaging & Collateral</h3>
          <p class="text-stone-600">
            CPG packaging, dielines, color separations, FDA-compliant copy, branded collateral and multi-SKU rollouts.
          </p>
        </div>

        <div
          class="bg-white/80 backdrop-blur-sm border border-white/50 rounded-xl p-6 shadow-md hover:shadow-lg transition-shadow animate-on-scroll"
        >
          <div
            class="w-12 h-12 bg-violet-100 rounded-lg flex items-center justify-center mb-4"
          >
            <svg
              class="w-6 h-6 text-violet-800"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="font-heading font-semibold text-xl mb-2">
            Brand & Marketing Design
          </h3>
          <p class="text-stone-600">
            Campaigns, retail signage, presentations, digital assets and template-driven visual systems.
          </p>
        </div>

        <div
          class="bg-white/80 backdrop-blur-sm border border-white/50 rounded-xl p-6 shadow-md hover:shadow-lg transition-shadow animate-on-scroll"
        >
          <div
            class="w-12 h-12 bg-violet-100 rounded-lg flex items-center justify-center mb-4"
          >
            <svg
              class="w-6 h-6 text-violet-800"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
              ></path>
            </svg>
          </div>
          <h3 class="font-heading font-semibold text-xl mb-2">
            Web & Digital Design
          </h3>
          <p class="text-stone-600">
            Websites, landing pages and product UI.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WORK GRID SECTION -->
  <section class="px-4 2xl:px-0 py-16 md:py-20">
    <div class="max-w-7xl mx-auto">
      <p
        class="text-sm font-semibold tracking-widest uppercase text-violet-800 mb-4 text-center animate-on-scroll"
      >
        Portfolio
      </p>
      <h2
        class="font-heading text-3xl md:text-4xl font-bold text-center mb-12 animate-on-scroll"
      >
        Selected Work
      </h2>

      <div
        class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-2"
      >
        <!-- TODO: re-add "California Magazine" card once real cover/spread graphics are ready -->
        <!-- <Card
          img={caMagazineThumb}
          alt="California Magazine — Editorial Design & Production"
          title="California Magazine — Editorial Design & Production"
          link="/work/california-magazine"
        /> -->
        <Card
          img={books}
          alt="Book Design & Production"
          title="Book Design & Production"
          link="/work/books"
        />
        <Card
          img={juice}
          alt="The Juice Magazine"
          title="The Juice Magazine"
          link="/work/juice"
        />
        <Card
          img={packagingThumb}
          alt="Packaging Production — SunQueen"
          title="Packaging Production"
          link="/work/sunqueen"
        />
        <LogoCard
          logo={mcdillLogo}
          alt="McDill Associates"
          title="McDill — Packaging & Production"
          link="/work/mcdill"
        />
        <Card
          img={westmarineThumb}
          alt="West Marine — Catalog Prepress"
          title="West Marine — Catalog Prepress"
          link="/work/westmarine"
        />
        <Card
          img={fastpencilcard}
          alt="FastPencil"
          title="FastPencil — Product & Print Design"
          link="/work/fastpencil"
        />
        <LogoCard
          logo={axwayLogo}
          alt="Axway"
          title="Axway — Global Brand System"
          link="/work/axway"
        />
        <Card
          img={kiteworkscard}
          alt="Kiteworks — Brand & Marketing"
          title="Kiteworks — Brand & Marketing"
          link="/work/kiteworks"
        />
        <Card
          img={openbankingcard}
          alt="Open Banking"
          title="Open Banking"
          link="/work/openbanking"
        />
        <Card
          img={lpc}
          alt="Live Price Check"
          title="Live Price Check"
          link="/work/livepricecheck"
        />
        <Card
          img={martinellisThumb}
          alt="Production Design"
          title="Production Design"
          link="/work/production-design"
        />
        <Card
          img={jackThumb}
          alt="Jack Pitts Photography"
          title="Jack Pitts Photography"
          link="/work/jack"
        />
        <!-- TODO: re-add "Websites for Small Businesses" card (links to /websites) when ready -->
        <!-- <Card
          img={jackWebsite}
          alt="Websites for Small Businesses"
          title="Websites for Small Businesses"
          link="/websites"
        /> -->
      </div>
    </div>
  </section>

  <!-- BIO SECTION -->
  <section class="px-4 2xl:px-0 py-16 md:py-20 bg-stone-100/50">
    <div class="max-w-4xl mx-auto">
      <p
        class="text-sm font-semibold tracking-widest uppercase text-violet-800 mb-4 text-center animate-on-scroll"
      >
        About
      </p>
      <h2
        class="font-heading text-3xl md:text-4xl font-bold text-center mb-8 animate-on-scroll"
      >
        Background & Experience
      </h2>

      <div class="prose prose-lg max-w-none text-stone-600 animate-on-scroll">
        <p class="mb-6">
          Graphic designer and production manager with 20+ years across magazine publishing, CPG packaging and enterprise marketing. I&rsquo;m currently designing and producing California magazine for the Cal Alumni Association — InDesign layouts, imagery, ad preflight, proofing and printer coordination through press. Earlier staff roles: print production manager at McDill Associates (packaging for Costco, Martinelli&rsquo;s and Rainbow Light), creative lead at FastPencil (50+ book covers and interiors a year), prepress manager at West Marine (800+ page national catalogs), and senior designer at Axway, Kiteworks and Wiser Solutions. I also design and build websites when a project calls for it.
        </p>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS SECTION -->
  <section class="px-4 2xl:px-0 py-16 md:py-20">
    <div class="max-w-4xl mx-auto">
      <p
        class="text-sm font-semibold tracking-widest uppercase text-violet-800 mb-4 text-center animate-on-scroll"
      >
        Testimonials
      </p>
      <h2
        class="font-heading text-3xl md:text-4xl font-bold text-center mb-12 animate-on-scroll"
      >
        What People Say
      </h2>

      <Testimonial
        quote="I worked with Matt on a variety of packaging and communication material design and production projects. Matt is very knowledgeable as well as personable, guiding the process to ensure expected creative outcomes."
        img={diana}
        alt="Diana McClean"
        person="Diana (DeVincenzi) McClean"
        title="Director of Marketing and Communications"
        company="Mission Produce"
      />

      <Testimonial
        quote="I find it refreshing to work with someone who knows how to tackle big projects while staying calm, focused and creative all while delivering outstanding work."
        img={jennine}
        alt="Jennine Dureau"
        person="Jennine Dureau"
        title="Marketing Manager"
        company="TurboTax"
      />

      <Testimonial
        quote="Matt is an incredible designer who works hard to identify/solve for customers’ pain points. His designs for critical and heavily used functionality were well received and had a lasting impact on the product adoption."
        img={abishek}
        alt="Abishek Aurora"
        person="Abishek Aurora"
        title="Director of Product"
        company="Credit Karma"
      />

      <Testimonial
        quote="Matt is a very creative individual. His knowledge of design as well as production techniques and crafts is invaluable and enables him to participate from start to finish on every project. From book covers to website and page design, Matt’s creative sense is remarkable and invaluable."
        img={bruce}
        alt="Bruce Butterfield"
        person="Bruce Butterfield"
        title="CEO and Founder"
        company="The Wittfield Group"
      />
    </div>
  </section>

  <!-- BRANDS SECTION -->
  <section class="px-4 2xl:px-0 py-16 md:py-20">
    <div class="max-w-5xl mx-auto">
      <p
        class="text-sm font-semibold tracking-widest uppercase text-violet-800 mb-4 text-center animate-on-scroll"
      >
        Experience
      </p>
      <h2
        class="font-heading text-3xl md:text-4xl font-bold text-center mb-12 animate-on-scroll"
      >
        Brands I&rsquo;ve Worked With
      </h2>
      <div class="animate-on-scroll">
        <LogoField />
      </div>
    </div>
  </section>

  <!-- CONTACT SECTION -->
  <section class="px-4 2xl:px-0 py-16 md:py-20 bg-stone-100/50">
    <div class="max-w-2xl mx-auto text-center">
      <p
        class="text-sm font-semibold tracking-widest uppercase text-violet-800 mb-4 animate-on-scroll"
      >
        Get in Touch
      </p>
      <h2
        class="font-heading text-3xl md:text-4xl font-bold mb-6 animate-on-scroll"
      >
        Looking for an experienced designer who understands production?
      </h2>
      <p class="text-xl text-stone-600 mb-8 animate-on-scroll">
        I&rsquo;m available for full-time, contract and project-based graphic design and production roles — hybrid or onsite in the SF Bay Area, Santa Cruz and Monterey, or remote.
      </p>
      <div
        class="flex flex-col sm:flex-row gap-4 justify-center items-center animate-on-scroll"
      >
        <a
          href="/MattOLeary_Resume_GraphicDesigner_ProductionManager.pdf"
          target="_blank"
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3 text-lg font-semibold text-violet-800 hover:text-violet-900 transition-colors"
        >
          <svg
            class="w-5 h-5 mr-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            ></path>
          </svg>
          View Resume
        </a>
        <a
          href="https://www.linkedin.com/in/matt-oleary/"
          target="_blank"
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3 text-lg font-semibold text-violet-800 hover:text-violet-900 transition-colors"
        >
          <Icon name="linkedin" class="w-5 h-5 mr-2" />
          LinkedIn
        </a>
        <a href="/contact" class="w-full sm:w-auto">
          <Button text="Contact Me" class="w-full" />
        </a>
      </div>
    </div>
  </section>
</Base>
