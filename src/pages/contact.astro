---
import Base from "../layouts/Base.astro";
---

<Base title="Contact" fullBleed>
  <!-- TITLE BAND -->
  <section class="on-dark bg-band text-on-band mx-2">
    <div class="max-w-container mx-auto px-gutter py-10 md:py-12">
      <a href="/" class="caps inline-flex items-center min-h-[44px] text-on-band hover:text-highlight transition-colors">
        <span class="mr-2" aria-hidden="true">&laquo;</span>Home
      </a>
      <h1 class="m-0 mt-2 text-h1 font-medium leading-tight text-on-band">Contact</h1>
    </div>
  </section>

  <section class="px-4 py-section">
    <div class="max-w-[640px] mx-auto">
      <p class="m-0 mb-12 text-center text-intro leading-body text-ink">
        Call <a href="tel:8312752566" class="text-link underline">831-275-2566</a>, send an <a href="mailto:matt@mattoleary.design" class="text-link underline">email</a>, or use the form below:
      </p>

      <form
        name="contact and subscribe"
        method="POST"
        netlify-honeypot="bot-field"
        data-netlify="true"
        class="flex flex-col gap-6"
      >
        <p class="hidden">
          <label>
            Don&rsquo;t fill this out if you&rsquo;re human: <input name="bot-field" />
          </label>
        </p>

        <div>
          <label for="contact-name" class="field-label">Name</label>
          <input id="contact-name" type="text" name="name" autocomplete="name" class="field" required />
        </div>

        <div>
          <label for="contact-email" class="field-label">Email</label>
          <input id="contact-email" type="email" name="email" autocomplete="email" class="field" required />
        </div>

        <div>
          <label for="contact-message" class="field-label">Message</label>
          <textarea id="contact-message" name="message" rows="5" class="field resize-y" required></textarea>
        </div>

        <button type="submit" class="btn-primary w-full">
          Send
        </button>
      </form>
    </div>
  </section>
</Base>

