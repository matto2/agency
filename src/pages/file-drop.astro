---
import "../styles/main.css";
import "@fontsource-variable/archivo";
import Back2 from "../components/Back2.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex" />
    <title>File Drop — Print-Ready Files. Fast.</title>
  </head>
  <body>
    <main class="min-h-screen flex items-start justify-center px-4 py-16">
      <div class="w-full max-w-xl">

        <Back2 />

        <h1 class="text-gray-800 mb-2 leading-tight">
          Print-Ready Files. Fast.
        </h1>
        <p class="text-gray-600 text-body mb-3 leading-relaxed">
          Send me your file and a quick description. I&rsquo;ll review it and get back to you with a quote &mdash; most jobs are $50 flat and turned around next day.
        </p>
        <p class="text-gray-700 font-medium mb-10">
          Questions?
          <a href="mailto:matt@mattoleary.design" class="text-band hover:underline">matt@mattoleary.design</a>
          &bull;
          <a href="tel:8312752566" class="text-band hover:underline">831-275-2566</a>
        </p>

        <form
          name="file-drop"
          method="POST"
          enctype="multipart/form-data"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="flex flex-col gap-6 mb-10"
        >
          <input type="hidden" name="form-name" value="file-drop" />

          <p class="hidden">
            <label>
              Don&rsquo;t fill this out if you&rsquo;re human: <input name="bot-field" />
            </label>
          </p>

          <div>
            <label class="field-label" for="name">Name</label>
            <input
              id="name"
              type="text"
              name="name"
              class="field"
              required
            />
          </div>

          <div>
            <label class="field-label" for="email">Email</label>
            <input
              id="email"
              type="email"
              name="email"
              class="field"
              required
            />
          </div>

          <div>
            <label class="field-label" for="phone">
              Phone <span class="text-gray-500">(optional)</span>
            </label>
            <input
              id="phone"
              type="tel"
              name="phone"
              class="field"
            />
          </div>

          <div>
            <label class="field-label" for="description">What needs fixing?</label>
            <textarea
              id="description"
              name="description"
              rows="4"
              class="field resize-y"
              required
            ></textarea>
          </div>

          <div>
            <label class="field-label" for="file">File</label>
            <input
              id="file"
              type="file"
              name="file"
              accept=".ai,.pdf,.eps,.psd,.indd,.png,.jpg,.jpeg,.zip"
              class="field cursor-pointer"
              required
            />
            <p class="mt-1 text-label text-gray-500">.ai .pdf .eps .psd .indd .png .jpg .zip</p>
          </div>

          <button
            type="submit"
            class="btn-primary w-full"
          >
            Send File
          </button>
        </form>

        <div class="space-y-3">
          <p class="text-gray-600">Color separations quoted separately.</p>
          <p class="text-gray-600">Based in Santa Cruz. 20+ years in production.</p>
        </div>

      </div>
    </main>
  </body>
</html>
