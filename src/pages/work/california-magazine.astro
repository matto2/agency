---
import Base from "../../layouts/Base.astro";
import ThinnerContent from "../../components/ThinnerContent.astro";
import Back from "../../components/Back.astro";
import { Image } from "astro:assets";
import heroImage from "../../assets/Berkeley_glade_afternoon.jpg";

const title = "Higher-Education Publications";
---

<Base title={title}>
  <ThinnerContent>
    <section class="mb-16">

      <h1 class="font-heading font-bold text-4xl sm:text-5xl my-8">{title}</h1>

      <Image
        src={heroImage}
        alt="UC Berkeley campus glade in afternoon light"
        class="w-full rounded-lg mb-10"
      />

      <div class="max-w-3xl mb-12">
        <p class="text-stone-700 leading-relaxed mb-6">
          I help universities, alumni organizations, and institutions
          produce polished, on-schedule publications&mdash;alumni and
          research magazines, annual reports, books, and special editions.
        </p>
        <p class="text-stone-700 leading-relaxed mb-6">
          Most recently, I managed the Fall 2026 issue of California
          magazine for the Cal Alumni Association: editorial layouts, image
          placement, revisions, prepress, and final press-ready delivery. I
          served as the main point of contact with the print vendor,
          ensuring the issue moved through production accurately and on
          deadline.
        </p>
        <p class="text-stone-700 leading-relaxed mb-6">
          That&rsquo;s built on 20+ years in editorial design and print
          production&mdash;prepress, color separations, imposition, and
          vendor coordination across magazines, packaging, and books. I
          bring a designer&rsquo;s eye and a production manager&rsquo;s
          discipline for keeping complex publications on track.
        </p>
        <p class="text-stone-700 leading-relaxed">
          If you need a steady hand for a single issue or an ongoing
          production partner, I can step into your existing workflow&mdash;including
          tight, deadline-driven windows&mdash;and get every issue out the
          door accurately and on time.
        </p>
      </div>

    </section>
    <Back next="/work/sunqueen" />
  </ThinnerContent>
</Base>
