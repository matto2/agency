---
import Base from "../../layouts/Base.astro";
import ThinnerContent from "../../components/ThinnerContent.astro";
import Back from "../../components/Back.astro";
import { Image } from "astro:assets";
import heroImage from "../../assets/Berkeley_glade_afternoon.jpg";

const title = "Higher-Education Publications";
---

<Base title={title}>
  <ThinnerContent>
    <section class="mb-16">

      <h1 class="font-heading font-bold text-4xl sm:text-5xl my-8">{title}</h1>

      <Image
        src={heroImage}
        alt="UC Berkeley campus glade in afternoon light"
        class="w-full rounded-lg mb-10"
      />

      <div class="max-w-3xl mb-12">
        <p class="text-stone-700 leading-relaxed mb-6">
          I help universities, alumni organizations, and institutions create
          thoughtful, beautifully designed publications&mdash;from alumni and
          research magazines to annual reports, books, and special
          publications.
        </p>
        <p class="text-stone-700 leading-relaxed mb-6">
          Most recently, I completed the Fall 2026 issue of California
          magazine for the Cal Alumni Association, managing the design and
          production process from editorial layouts and image placement
          through revisions, prepress, final proofs, and press-ready
          delivery. I also worked directly with the print vendor to help
          ensure the issue was produced accurately and on schedule.
        </p>
        <p class="text-stone-700 leading-relaxed mb-6">
          That experience builds on more than 20 years in editorial design,
          publishing, and print production. I bring both a designer&rsquo;s
          eye and a production manager&rsquo;s understanding of what it takes
          to move a complex publication from content and assets to a
          finished piece.
        </p>
        <p class="text-stone-700 leading-relaxed">
          Whether you need support for a single issue or an ongoing
          publication partner, I can step into your existing workflow and
          help get every issue across the finish line&mdash;beautifully,
          accurately, and on schedule.
        </p>
      </div>

    </section>
    <Back next="/work/sunqueen" />
  </ThinnerContent>
</Base>
