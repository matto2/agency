---
import Base from "../../layouts/Base.astro";
import ThinnerContent from "../../components/ThinnerContent.astro";
import Back from "../../components/Back.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import heroImage from "../../assets/Berkeley_glade_afternoon.jpg";
import coverImage from "../../assets/california-mag-fall2026-cover.jpg";

const pdfHref = "/California-Mag-Fall2026_lo.pdf";

const title = "Higher-Education Publications";
---

<Base title={title}>
  <ThinnerContent>
    <section class="mb-16">

      <h1 class="my-8">{title}</h1>

      <Image
        src={heroImage}
        alt="UC Berkeley campus glade in afternoon light"
        class="w-full rounded-token mb-10"
      />

      <div class="max-w-3xl mb-12">
        <p class="text-stone-700 leading-relaxed mb-6">
          I help universities, alumni organizations, and institutions
          produce polished, on-schedule publications&mdash;alumni and
          research magazines, annual reports, books, and special editions.
        </p>
        <p class="text-stone-700 leading-relaxed mb-6">
          I&rsquo;m currently Designer &amp; Production Manager for <em>California</em> magazine
          at the Cal Alumni Association. For each issue, I lay out many of the
          non-feature spreads and handle image placement, revisions, prepress,
          and final press-ready delivery. I&rsquo;m also the main point of contact
          with the print vendor, keeping every issue moving through production
          accurately and on deadline. The latest is the Fall 2026 issue:
        </p>
        <div class="flex flex-col sm:flex-row sm:items-center gap-6 mb-8">
          <a href={pdfHref} target="_blank" class="block w-40 shrink-0">
            <Image
              src={coverImage}
              alt="Cover of the Fall 2026 issue of California magazine"
              width={320}
              class="w-full rounded-token transition-shadow"
            />
          </a>
          <div>
            <a
              href={pdfHref}
              target="_blank"
              class="inline-flex items-center font-medium text-band hover:text-ink transition-colors"
            >
              <Icon name="pdf" class="w-5 h-5 mr-2" />
              <span><em>California</em> magazine, Fall 2026 (PDF)</span>
            </a>
          </div>
        </div>
        <p class="text-stone-700 leading-relaxed mb-6">
          That&rsquo;s built on 20+ years in editorial design and print
          production&mdash;prepress, color separations, imposition, and
          vendor coordination across magazines, packaging, and books. I
          bring a designer&rsquo;s eye and a production manager&rsquo;s
          discipline for keeping complex publications on track.
        </p>
        <p class="text-stone-700 leading-relaxed">
          I can do the same for your publication. Whether you need a steady
          hand for a single issue or an ongoing production partner, I step into
          your existing workflow&mdash;including tight, deadline-driven
          windows&mdash;and get every issue out the door accurately and on time.
        </p>
      </div>

    </section>
    <Back next="/work/sunqueen" />
  </ThinnerContent>
</Base>
